          },
          "expr": "sum by (outcome) (rate(tempo_authz_decisions_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Watson auth and unmatched routes",
      "id": 13,
      "datasource": {
        "type": "prometheus",
