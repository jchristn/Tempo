        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (watson_auth_authn, watson_auth_authz) (rate(watson_auth_requests_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{watson_auth_authn}} / {{watson_auth_authz}}",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(watson_route_unmatched_total{job=~\"$job\"}[$__rate_interval]))",
