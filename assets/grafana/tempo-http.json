        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (method, outcome) (rate(tempo_auth_attempts_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{outcome}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Authorization decisions",
      "id": 12,
      "datasource": {
        "type": "prometheus",
