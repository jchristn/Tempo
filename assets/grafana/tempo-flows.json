      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(tempo_pipeline_stage_duration_seconds_bucket{pipeline=\"flow\"}[$__rate_interval])))",
          "legendFormat": "{{stage}}",
          "refId": "A",
          "range": true
        }
      ]
    }
  ]
