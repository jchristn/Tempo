          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (runner) (rate(tempo_step_executions_total{job=~\"$job\", outcome!=\"success\"}[$__rate_interval])) / clamp_min(sum by (runner) (rate(tempo_step_executions_total{job=~\"$job\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{runner}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Per-step stage p95",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "resolve = step lookup; validate = config and contract checks; prepare = runner creation, including artifact download and cache fill.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
