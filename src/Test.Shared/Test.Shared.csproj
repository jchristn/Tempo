<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>    <Version>0.5.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tempo.Core\Tempo.Core.csproj" />
    <ProjectReference Include="..\Tempo.McpServer\Tempo.McpServer.csproj" />
    <ProjectReference Include="..\Tempo.Server\Tempo.Server.csproj" />
    <ProjectReference Include="..\Tempo.Worker\Tempo.Worker.csproj" />
    <ProjectReference Include="..\Test.ArtifactFixture\Test.ArtifactFixture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Tempo.Sample.DotnetProcess\Tempo.Sample.DotnetProcess.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Touchstone.Core" Version="0.2.0" />
    <!-- Direct reference so the Voltaic assemblies flow to the test output; Tempo.McpServer is an Exe project and does not propagate its package dependencies transitively. -->
    <PackageReference Include="Voltaic" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ProtocolGoldenFiles\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
