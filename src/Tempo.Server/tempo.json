{
  "createdUtc": "2026-04-18T00:00:00.000Z",
  "rest": {
    "hostname": "127.0.0.1",
    "port": 8901,
    "ssl": false
  },
  "database": {
    "type": "Sqlite",
    "filename": "./tempo.db",
    "commandTimeoutSeconds": 30
  },
  "logging": {
    "consoleLogging": true,
    "fileLogging": true,
    "logDirectory": "./logs",
    "logFilename": "tempo.log"
  },
  "auth": {
    "issuer": "tempo",
    "signingKey": "tempo-development-key-override-for-production-use",
    "tokenExpirationMinutes": 1440,
    "adminApiKey": ""
  },
  "requestHistory": {
    "enabled": true,
    "maxRequestBodyBytes": 65536,
    "maxResponseBodyBytes": 65536,
    "retentionDays": 30,
    "pruneIntervalMinutes": 60
  },
  "logViewer": {
    "workerRootPath": "./worker-logs",
    "workerLogFilename": "tempo-worker.log",
    "defaultTailLines": 200,
    "maxTailLines": 5000,
    "defaultMaxBytes": 131072,
    "maxReadBytes": 1048576
  },
  "engine": {
    "queueEnabled": true,
    "serverCanExecuteWorkload": true,
    "maxConcurrentRuns": 4,
    "pollIntervalMs": 1000,
    "loadBalancingStrategy": "LeastLoaded",
    "workerHeartbeatTimeoutMs": 30000,
    "leaseDurationMs": 300000,
    "maxAssignmentAttempts": 3,
    "allowDuplicateScheduler": false
  },
  "runtimes": {
    "externalExecution": {
      "maxConcurrentProcessesServerWide": 4,
      "maxConcurrentProcessesPerTenant": 2,
      "defaultMaxRuntimeMs": 30000,
      "maxStdoutBytes": 1048576,
      "maxStderrBytes": 1048576,
      "maxInputBytes": 1048576,
      "maxOutputBytes": 1048576,
      "scratchRoot": "./scratch",
      "cacheRoot": "./runtime-cache",
      "environmentAllowList": [],
      "networkPolicyMode": "disabled",
      "killProcessTreeOnCancel": true,
      "pythonExecutable": "python",
      "nodeExecutable": "node",
      "dotnetExecutable": "dotnet",
      "allowPythonDependencyInstall": false
    },
    "hostExecutables": {
      "enabled": false,
      "allowList": []
    }
  },
  "hydration": {
    "seedDefaults": true,
    "defaultTenantName": "Default Tenant",
    "defaultAdminEmail": "admin@tempo.local",
    "defaultAdminPassword": "password",
    "defaultUserEmail": "user@tempo.local",
    "defaultUserPassword": "password"
  }
}
