<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Tempo</Title>
    <Authors>jchristn</Authors>
    <Description>Tempo orchestrates data flows through coordinated steps you define.</Description>
    <Copyright>(c)2026 Joel Christner</Copyright>
    <PackageProjectUrl>https://github.com/jchristn/tempo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jchristn/tempo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <DocumentationFile>Tempo.xml</DocumentationFile>
    <Version>0.5.1</Version>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>data flow dataflow orchestrate orchestrator step lambda faas airflow</PackageTags>
    <PackageReleaseNotes>Built-in observability: the Tempo meter and activity source (System.Diagnostics) emit flow, step, integration, database, dispatch, worker, capacity, cache, and task metrics and spans with W3C context propagation. No exporter dependency; subscribe from your host. See TELEMETRY.md.</PackageReleaseNotes>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Padlock" Version="1.2.0" />
    <PackageReference Include="PrettyId" Version="2.0.1" />
    <PackageReference Include="RestWrapper" Version="3.3.1" />
    <PackageReference Include="SyslogLogging" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Helpers\" />
    <Folder Include="Runners\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\LICENSE.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
