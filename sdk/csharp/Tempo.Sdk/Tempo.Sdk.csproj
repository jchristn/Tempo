<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>    <AssemblyName>Tempo.Sdk</AssemblyName>
    <RootNamespace>Tempo.Sdk</RootNamespace>
    <Version>0.3.1</Version>
    <PackageId>Tempo.Sdk</PackageId>
    <Authors>Tempo</Authors>
    <Description>Tempo protocol v1 SDK for .NET artifact step handlers.</Description>
    <PackageProjectUrl>https://github.com/jchristn/tempo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jchristn/tempo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Copyright>(c)2026 Joel Christner</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageTags>tempo sdk protocol workflow pipeline step handler</PackageTags>
    <PackageIcon>logo.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PrettyId" Version="2.0.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\..\LICENSE.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\assets\logo.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
